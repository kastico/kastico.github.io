---
// Edit the contact details here
const email = 'antonio_barbosa00@live.com.pt';
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/antonio-barbosa00/' },
  { label: 'GitHub', href: 'https://github.com/kastico' },
];
---

<section class="contact">
  <span class="section-label">Contact</span>
  <p>Open to new opportunities and interesting projects. Feel free to say hi.</p>
  <div class="actions">
    <a class="primary" href={`mailto:${email}`}>{email}</a>
    {links.map(l => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
  </div>
</section>

<style>
  .contact { margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); }
  .contact p { font-size: 0.92rem; color: var(--gray); margin: 0.5rem 0 1rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .actions a { font-size: 0.8rem; padding: 0.4rem 0.8rem; border: 1px solid var(--border); border-radius: 4px; color: var(--gray-light); }
  .actions a:hover { border-color: var(--accent); text-decoration: none; }
  .actions a.primary { border-color: var(--accent); color: var(--accent-light); }
</style>