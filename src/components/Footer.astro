---
const year = new Date().getFullYear();
---

<footer>
  <span>&copy; {year} Kastico</span>
  <div class="links">
    <a href="https://m.webtoo.ls/@kastico" target="_blank">Mastodon</a>
    <a href="https://x.com/_kastico" target="_blank">Twitter</a>
    <a href="https://github.com/kastico" target="_blank">GitHub</a>
  </div>
</footer>

<style>
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 4rem auto 0;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--gray);
    font-size: 0.85rem;
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  .links a {
    color: var(--gray);
    text-decoration: none;
  }
  .links a:hover { color: var(--gray-light); }

  @media (max-width: 480px) {
    footer { flex-direction: column; gap: 1rem; text-align: center; }
  }
</style>
