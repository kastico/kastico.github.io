---
interface Props {
  src: string;
  maxWidth?: string; // largura máxima do carrossel
  height?: string;   // altura fixa do palco
}
const { src, maxWidth = '900px', height = 'min(75vh, 650px)' } = Astro.props;
---

<div class="pdf-carousel" data-src={src} style={`--pdf-max-width:${maxWidth};--pdf-height:${height};`} tabindex="0">
  <div class="stage">
    <canvas class="main-canvas"></canvas>
    <button class="nav prev" aria-label="Página anterior">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="nav next" aria-label="Página seguinte">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <button class="expand" aria-label="Ecrã inteiro">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
    </button>
  </div>
  <div class="bar">
    <span class="counter"><span class="cur">1</span> / <span class="total">–</span></span>
  </div>

  <dialog class="lb" aria-label="Página em ecrã inteiro">
    <button class="lb-btn lb-close" aria-label="Fechar">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <button class="lb-btn lb-prev" aria-label="Página anterior">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <canvas class="lb-canvas"></canvas>
    <button class="lb-btn lb-next" aria-label="Página seguinte">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
    <span class="lb-count"></span>
  </dialog>
</div>

<script>
  import * as pdfjs from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import '../styles/lightbox.css';

  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

  document.querySelectorAll<HTMLElement>('.pdf-carousel').forEach(async (root) => {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.main-canvas')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    const expand = root.querySelector<HTMLButtonElement>('.expand')!;
    const cur = root.querySelector('.cur')!;
    const total = root.querySelector('.total')!;

    const dlg = root.querySelector<HTMLDialogElement>('.lb')!;
    const lbCanvas = dlg.querySelector<HTMLCanvasElement>('.lb-canvas')!;
    const lbPrev = dlg.querySelector<HTMLButtonElement>('.lb-prev')!;
    const lbNext = dlg.querySelector<HTMLButtonElement>('.lb-next')!;
    const lbCount = dlg.querySelector('.lb-count')!;

    const url = root.getAttribute('data-src');
    if (!url) { console.warn('PdfCarousel sem src', root); return; }

    const pdf = await pdfjs.getDocument({ url }).promise;
    const pages = pdf.numPages;
    total.textContent = String(pages);

    // desenha a página n num canvas, ajustada à caixa (mantém proporção)
    function makeRenderer(target: HTMLCanvasElement, box: () => { w: number; h: number }) {
      let task: { cancel: () => void; promise: Promise<unknown> } | null = null;
      let token = 0;
      return async (n: number) => {
        const my = ++token;
        task?.cancel();
        const page = await pdf.getPage(n);
        if (my !== token) return;
        const base = page.getViewport({ scale: 1 });
        const { w, h } = box();
        if (!w || !h) return;
        const fit = Math.min(w / base.width, h / base.height);
        const dpr = window.devicePixelRatio || 1;
        const viewport = page.getViewport({ scale: fit * dpr });

        target.width = Math.floor(viewport.width);
        target.height = Math.floor(viewport.height);
        target.style.width = `${Math.floor(base.width * fit)}px`;
        target.style.height = `${Math.floor(base.height * fit)}px`;

        task = page.render({ canvas: target, viewport });
        try { await task.promise; } catch { /* cancelado por clique rápido */ }
      };
    }

    const renderMain = makeRenderer(canvas, () => ({ w: stage.clientWidth, h: stage.clientHeight }));
    const renderLb = makeRenderer(lbCanvas, () => ({ w: window.innerWidth * 0.95, h: window.innerHeight * 0.92 }));

    // ---------- carrossel ----------
    let n = 1;

    const showMain = () => {
      cur.textContent = String(n);
      prev.disabled = n === 1;
      next.disabled = n === pages;
      renderMain(n);
    };

    const go = (d: number) => {
      n = Math.min(pages, Math.max(1, n + d));
      showMain();
    };

    prev.onclick = () => go(-1);
    next.onclick = () => go(1);
    root.addEventListener('keydown', (e) => {
      if (dlg.open) return;
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    new ResizeObserver(() => renderMain(n)).observe(stage);

    // ---------- lightbox ----------
    let li = 1;

    const showLb = (i: number) => {
      li = Math.min(pages, Math.max(1, i));
      lbCount.textContent = `${li} / ${pages}`;
      lbPrev.disabled = li === 1;
      lbNext.disabled = li === pages;
      renderLb(li);
    };

    const open = () => {
      dlg.showModal();
      showLb(n);
    };

    canvas.addEventListener('click', open);
    expand.onclick = open;

    lbPrev.onclick = () => showLb(li - 1);
    lbNext.onclick = () => showLb(li + 1);
    dlg.querySelector<HTMLButtonElement>('.lb-close')!.onclick = () => dlg.close();

    // clicar no fundo escuro (fora do canvas e dos botões) fecha
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') showLb(li - 1);
      if (e.key === 'ArrowRight') showLb(li + 1);
    });

    window.addEventListener('resize', () => { if (dlg.open) renderLb(li); });

    // ao fechar, o carrossel fica na última página vista
    dlg.addEventListener('close', () => {
      n = li;
      showMain();
    });

    showMain();
  });
</script>

<style>
  .pdf-carousel {
    max-width: var(--pdf-max-width);
    margin: 2rem auto;
    outline: none;
  }
  .stage {
    position: relative;
    width: 100%;
    height: var(--pdf-height);
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.25);
    border-radius: 8px;
    overflow: hidden;
  }
  .main-canvas {
    display: block;
    margin: 0;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.35);
    cursor: zoom-in;
  }
  .nav,
  .expand {
    position: absolute;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
  }
  .expand {
    top: 0.75rem;
    right: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
  }
  .nav svg,
  .expand svg { display: block; }
  .nav:hover:not(:disabled),
  .expand:hover { background: rgb(0 0 0 / 0.8); }
  .nav:disabled { opacity: 0.25; cursor: default; }
  .prev { left: 0.75rem; }
  .next { right: 0.75rem; }
  .bar {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  /* o canvas do lightbox é específico deste componente */
  .lb-canvas {
    display: block;
    margin: 0;
    box-shadow: 0 8px 40px rgb(0 0 0 / 0.5);
  }
</style>
