---
import { getTagConfig } from '../content/tags.config';

interface Props {
  tag: string;
  href?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { tag, href, size = 'md' } = Astro.props;
const config = getTagConfig(tag);

const padding = size === 'sm' ? '0.2rem 0.5rem' : size === 'lg' ? '0.35rem 0.8rem' : '0.25rem 0.65rem';
const fontSize = size === 'sm' ? '0.7rem' : size === 'lg' ? '0.85rem' : '0.75rem';

const style = `
  background: ${config.bgColor};
  color: ${config.textColor};
  border: 1px solid ${config.color}30;
  padding: ${padding};
  font-size: ${fontSize};
  border-radius: 4px;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
`;
---
{href
  ? <a href={href} style={style}>#{tag}</a>
  : <span style={style}>#{tag}</span>
}
