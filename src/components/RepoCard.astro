---
interface Props {
  repo: string;          // "kastico/gquick"
  description?: string;  // substitui a descrição do GitHub
}
const { repo, description } = Astro.props;

// cache em memória: evita repetir pedidos durante o dev
const cache: Map<string, any> = ((globalThis as any).__repoCache ??= new Map());
let data = cache.get(repo);

if (!data) {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const res = await fetch(`https://api.github.com/repos/${repo}`, {
      headers: {
        Accept: 'application/vnd.github+json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    });
    if (res.ok) data = await res.json();
  } catch {}
  if (data) cache.set(repo, data);
}

const desc = description ?? data?.description;
---

<a class="repo" href={`https://github.com/${repo}`} target="_blank" rel="noopener">
  <div class="top">
    <span class="name">{repo}</span>
    {data && <span class="stars">★ {data.stargazers_count}</span>}
  </div>
  {desc && <p class="desc">{desc}</p>}
  {data?.language && <span class="lang">{data.language}</span>}
</a>

<style>
  .repo {
    display: block;
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 10px;
    transition: border-color 0.2s;
  }
  .repo:hover { border-color: color-mix(in srgb, currentColor 45%, transparent); }
  .top { display: flex; justify-content: space-between; gap: 1rem; }
  .name { font-weight: 500; }
  .stars { font-size: 0.85rem; opacity: 0.7; white-space: nowrap; }
  .desc { margin: 0.5rem 0 0; font-size: 0.9rem; opacity: 0.75; }
  .lang {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 2px 10px;
    font-size: 0.75rem;
    border-radius: 6px;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
</style>
