---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import '@fontsource/orbitron/900.css';
import '@fontsource/zen-dots/400.css';
---

<header>
  <nav>
<a href="/" class="logo">
  <img src="/logo.png" alt="" class="logo-img" width="40" height="40" />
  <span class="logo-text">BUNKER<em>Labs</em></span>
</a>

    <div class="links">
      <HeaderLink href="/vaults">Vaults</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>

    <div class="socials">
      <a href="https://m.webtoo.ls/@kastico" target="_blank" title="Mastodon" aria-label="Mastodon">
        <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M11.19 12.195c2.016-.24 3.77-1.475 3.99-2.603.348-1.778.32-4.339.32-4.339 0-3.47-2.286-4.488-2.286-4.488C12.062.238 10.083.017 8.027 0h-.05C5.92.017 3.942.238 2.79.765c0 0-2.285 1.017-2.285 4.488l-.002.662c-.004.64-.007 1.35.011 2.091.083 3.394.626 6.74 3.78 7.57 1.454.383 2.703.463 3.709.408 1.823-.1 2.847-.647 2.847-.647l-.06-1.317s-1.303.41-2.767.36c-1.45-.05-2.98-.156-3.215-1.928a3.614 3.614 0 0 1-.033-.496s1.424.346 3.228.428c1.103.05 2.137-.064 3.188-.189zm1.613-2.47H11.13v-4.08c0-.859-.364-1.295-1.091-1.295-.804 0-1.207.517-1.207 1.541v2.233H7.168V5.89c0-1.024-.403-1.541-1.207-1.541-.727 0-1.091.436-1.091 1.296v4.079H3.197V5.522c0-.859.22-1.541.66-2.046.456-.505 1.052-.764 1.793-.764.856 0 1.504.328 1.933.983L8 4.39l.417-.695c.429-.655 1.077-.983 1.934-.983.74 0 1.336.259 1.791.764.442.505.661 1.187.661 2.046v4.203z"/></svg>
      </a>
      <a href="https://x.com/_kastico" target="_blank" title="Twitter" aria-label="Twitter">
        <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"/></svg>
      </a>
      <a href="https://github.com/kastico" target="_blank" title="GitHub" aria-label="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
    </div>

    <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <div class="overlay" id="overlay"></div>

    <div class="mobile-nav" id="mobileNav">
      <a href="/" class="mobile-link">Home</a>
      <a href="/vaults" class="mobile-link">Vaults</a>
      <a href="/blog" class="mobile-link">Blog</a>
      <a href="/about" class="mobile-link">About</a>
      <div class="mobile-socials">
        <a href="https://m.webtoo.ls/@kastico" target="_blank">Mastodon</a>
        <a href="https://x.com/_kastico" target="_blank">Twitter</a>
        <a href="https://github.com/kastico" target="_blank">GitHub</a>
      </div>
    </div>
  </nav>
</header>

<style>
header {
  background-color: var(--background, #0a0b0d);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
}

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    height: 60px;
    padding: 0 1.5rem;
    position: relative;
  }
  
  .logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  flex-shrink: 0;
}

.logo:hover { text-decoration: none; }
.logo:hover .logo-text em { color: var(--accent-light); }

.logo-img {
  width: 46px;
  height: 46px;
  object-fit: contain;
  opacity: 0.9;
  flex-shrink: 0;
  border: 0;
}

.logo-text {
  --fs: 1.25rem; /* antes 1.4rem */
  --halo: 1px;
  position: relative;
  display: inline-block;
  transform: translateY(-0.1em);
  font-family: 'Orbitron', sans-serif;
  font-weight: 900;
  font-size: var(--fs);
  line-height: 1;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  color: #c5ccd8;
}

.logo-text em {
  position: absolute;
  left: calc(50% - var(--fs) * 0.03);
  top: calc(var(--fs) * 0.64);
  transform: translateX(-50%);
  display: block;
  font-family: 'Zen Dots', sans-serif;
  font-style: normal;
  font-weight: 400;
  font-size: calc(var(--fs) * 0.5);
  line-height: 1;
  letter-spacing: 0.45em;
  padding-left: 0.45em;
  white-space: nowrap;
  color: #a688e8;
  text-shadow:
    var(--halo) 0 0 var(--background), calc(var(--halo) * -1) 0 0 var(--background),
    0 var(--halo) 0 var(--background), 0 calc(var(--halo) * -1) 0 var(--background),
    var(--halo) var(--halo) 0 var(--background), calc(var(--halo) * -1) var(--halo) 0 var(--background),
    var(--halo) calc(var(--halo) * -1) 0 var(--background), calc(var(--halo) * -1) calc(var(--halo) * -1) 0 var(--background);
  transition: color 0.15s;
}

.logo-text i { font-style: normal; }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .links :global(a) {
    color: var(--gray);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: color 0.15s;
  }
  .links :global(a:hover),
  .links :global(a.active) { color: var(--gray-light); text-decoration: none; }
  .links :global(a.active) { font-weight: 600; }

  .socials { display: flex; align-items: center; gap: 0.25rem; }
  .socials a {
    display: flex; align-items: center; justify-content: center;
    padding: 0.4rem; border-radius: 4px; color: var(--gray); transition: color 0.15s;
  }
  .socials a:hover { color: var(--gray-light); text-decoration: none; }

  .hamburger {
    display: none; flex-direction: column; justify-content: center;
    gap: 5px; width: 32px; height: 32px; background: none; border: none;
    cursor: pointer; padding: 0; margin-left: auto;
  }
  .hamburger span { display: block; height: 2px; width: 100%; background: var(--gray-light); border-radius: 2px; transition: all 0.25s ease; }
  .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .hamburger.active span:nth-child(2) { opacity: 0; }
  .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }

  .overlay { display: none; position: fixed; inset: 0; background: rgba(8,10,12,0.8); z-index: 99; opacity: 0; transition: opacity 0.25s; }
  .overlay.active { opacity: 1; }

.mobile-nav { display: none; position: fixed; top: 0; right: -100%; width: 280px; height: 100vh; background: var(--card-bg); border-left: 1px solid var(--border); z-index: 100; flex-direction: column; padding: 5rem 1.5rem 2rem; gap: 0.25rem; visibility: hidden; transition: right 0.3s ease, visibility 0s 0.3s; }
.mobile-nav.active { right: 0; visibility: visible; transition: right 0.3s ease; }
  .mobile-link { color: var(--gray-light); text-decoration: none; padding: 0.75rem 0.5rem; border-radius: 4px; font-size: 1.1rem; border-bottom: 1px solid var(--border); }
  .mobile-link:hover { color: var(--accent-light); text-decoration: none; }
  .mobile-socials { display: flex; gap: 1.5rem; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .mobile-socials a { color: var(--gray); font-size: 0.85rem; }
  .mobile-socials a:hover { color: var(--gray-light); }

  @media (max-width: 768px) {
    .links, .socials { display: none; }
    .hamburger { display: flex; }
    .overlay { display: block; visibility: hidden; pointer-events: none; }
    .overlay.active { visibility: visible; pointer-events: auto; }
    .mobile-nav { display: flex; }
  }
</style>

<script is:inline>
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('mobileNav');
  const overlay = document.getElementById('overlay');
  function toggle() {
    const open = hamburger.classList.toggle('active');
    mobileNav.classList.toggle('active', open);
    overlay.classList.toggle('active', open);
    hamburger.setAttribute('aria-expanded', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }
  function close() {
    hamburger.classList.remove('active');
    mobileNav.classList.remove('active');
    overlay.classList.remove('active');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  hamburger.addEventListener('click', toggle);
  overlay.addEventListener('click', close);
  document.querySelectorAll('.mobile-link').forEach(l => l.addEventListener('click', close));
  document.addEventListener('keydown', e => e.key === 'Escape' && close());
</script>
