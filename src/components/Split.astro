---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fullUrl } from '../utils/media';

interface Props {
  image: ImageMetadata | string;
  alt?: string;
  caption?: string;
  reverse?: boolean;   // imagem à esquerda
  border?: boolean;    // borda visível à volta da imagem (por omissão: ligada)
}
const { image, alt = '', caption, reverse = false, border = true } = Astro.props;
const full = await fullUrl(image);
---

<div class:list={['split', { reverse, bordered: border }]}>
  <div class="text"><slot /></div>
  <figure class="media">
    {typeof image === 'string'
      ? <img src={image} alt={alt} loading="lazy" data-lightbox="page" data-full={full} />
      : <Image src={image} alt={alt} width={1000} data-lightbox="page" data-full={full} />}
    {caption && <figcaption class="caption">{caption}</figcaption>}
  </figure>
</div>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    align-items: center;
    margin: 2rem 0;
  }
  .reverse .media { order: -1; }
  .text > :global(:first-child) { margin-top: 0; }
  .text > :global(:last-child) { margin-bottom: 0; }
  .media { margin: 0; }
  .media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    box-sizing: border-box;
    border-radius: var(--radius-media, 8px);
    cursor: zoom-in;
  }
  .bordered .media :global(img) {
    border: 1px solid var(--border-color, var(--gray));
  }
  /* sem border: anula também qualquer borda vinda de CSS global (ex.: .prose img) */
  .split:not(.bordered) .media :global(img) {
    border: none;
    outline: none;
    box-shadow: none;
  }
  .caption {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    font-style: italic;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-align: center;
    color: var(--gray);
    opacity: 0.85;
  }
  @media (max-width: 700px) {
    .split { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .media { order: -1; }   /* no telemóvel a imagem vem sempre primeiro */
  }
</style>
