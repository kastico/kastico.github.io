---
interface Props {
  images: string[];
  alt?: string;
  maxWidth?: string;
  height?: string;
}
const { images, alt = '', maxWidth = '900px', height = 'min(70dvh, 650px)' } = Astro.props;
const group = `ss-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="slideshow" style={`--ss-max-width:${maxWidth};--ss-height:${height};`} tabindex="0">
  <div class="stage">
    <div class="track">
      {images.map((src, n) => (
        <div class="slide">
          <img src={src} alt={`${alt} ${n + 1}`} loading="lazy" data-lightbox={group} data-full={src} />
        </div>
      ))}
    </div>
    <button class="nav prev" aria-label="Anterior">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button class="nav next" aria-label="Seguinte">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
  <div class="bar"><span class="cur">1</span> / {images.length}</div>
</div>

<script>
  import '../scripts/lightbox';

  document.querySelectorAll<HTMLElement>('.slideshow').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    const cur = root.querySelector('.cur')!;
    const imgs = Array.from(track.querySelectorAll('img'));

    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const update = () => {
      const n = index();
      cur.textContent = String(n + 1);
      prev.disabled = n === 0;
      next.disabled = n >= imgs.length - 1;
    };
    const go = (d: number) => {
      const n = Math.min(imgs.length - 1, Math.max(0, index() + d));
      track.scrollTo({ left: n * track.clientWidth, behavior: 'smooth' });
    };

    prev.onclick = () => go(-1);
    next.onclick = () => go(1);
    track.addEventListener('scroll', update, { passive: true });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    // ao fechar o lightbox, alinha com a última imagem vista
    root.addEventListener('lightbox:close', (e) => {
      const n = imgs.indexOf(e.target as HTMLImageElement);
      if (n >= 0) track.scrollTo({ left: n * track.clientWidth, behavior: 'instant' });
    });
    update();
  });
</script>

<style>
  .slideshow { max-width: var(--ss-max-width); margin: 2rem auto; outline: none; }
  .stage {
    position: relative;
    height: var(--ss-height);
    background: rgb(0 0 0 / 0.25);
    border-radius: var(--radius-media, 8px);
    overflow: hidden;
  }
  .track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; height: 100%; display: grid; place-items: center; scroll-snap-align: start; }
  .slide img {
    display: block;
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    border-radius: 0;
    object-fit: contain;
    cursor: zoom-in;
  }
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }
  .nav:hover:not(:disabled) { background: rgb(0 0 0 / 0.8); }
  .nav:disabled { opacity: 0.25; cursor: default; }
  .prev { left: 0.75rem; }
  .next { right: 0.75rem; }
  .bar {
    margin-top: 0.75rem;
    font-size: var(--fs-label, 0.8rem);
    text-align: right;
    color: var(--text-soft, inherit);
  }

  /* telemóvel: botões maiores, e o swipe nativo do scroll faz o resto */
  @media (pointer: coarse) {
    .nav { width: 2.75rem; height: 2.75rem; }
  }
</style>
