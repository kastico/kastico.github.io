---
// Edit the stack here (same tags as the CV)
const stack = [
  { label: 'Daily', items: ['C++', 'Qt / QML', 'PostgreSQL', 'SQLite', 'CMake', 'Git', 'Linux'] },
  { label: 'Comfortable', items: ['Bash', 'Docker', 'Proxmox', 'Figma', 'Neovim'] },
  { label: 'Exploring', items: ['JavaScript', 'Embedded', 'Raspberry Pi', 'CI/CD'], dashed: true },
];
const platforms = ['Linux', 'Windows', 'macOS', 'Android'];
---

<section class="term" aria-label="Stack">
  <div class="term-bar"><span></span><span></span><span></span><em>kastico@bunker: ~</em></div>
  <div class="term-body">
    <p class="cmd"><span class="prompt">$</span>whoami</p>
    <p class="out">António Barbosa · software developer · designer at heart</p>

    <p class="cmd"><span class="prompt">$</span>cat stack</p>
    <div class="out stack">
      {stack.map(g => (
        <div class="row">
          <span class="group">{g.label}</span>
          <ul class="chips">
            {g.items.map(s => <li class:list={['chip', { dashed: g.dashed }]}>{s}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="cmd"><span class="prompt">$</span>ls platforms/</p>
    <p class="out platforms">{platforms.join('   ')}</p>

    <p class="cmd"><span class="prompt">$</span><span class="cursor"></span></p>
  </div>
</section>

<style>
  .term { border: 1px solid var(--border); border-radius: 8px; background: var(--card-bg); margin: 0 0 4rem; overflow: hidden; }
  .term-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--border); }
  .term-bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--border); }
  .term-bar em { margin-left: 0.6rem; font-style: normal; font-size: 0.72rem; color: var(--gray); }
  .term-body { padding: 1.25rem 1.5rem 1.4rem; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.85rem; line-height: 1.7; }
  .term-body p { margin: 0; }
  .cmd { color: var(--gray-light); }
  .cmd:not(:first-child) { margin-top: 1.25rem; }
  .prompt { color: var(--accent-light); margin-right: 0.5rem; }
  .out { color: var(--gray); padding-left: 1.1rem; margin-top: 0.15rem; }
  .platforms { white-space: pre-wrap; }

  /* stack: same tag style as the CV */
  .stack { display: grid; gap: 0.7rem; margin-top: 0.6rem; }
  .row { display: grid; grid-template-columns: 7.5rem 1fr; align-items: baseline; gap: 0.75rem; }
  .group { font-size: 0.74rem; color: var(--gray); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 0.78rem; line-height: 1;
    padding: 0.38rem 0.65rem;
    border: 1px solid var(--border); border-radius: 4px;
    color: var(--gray-light); background: transparent;
  }
  .chip.dashed { border-style: dashed; border-color: var(--accent-light); color: var(--accent-light); }

  .cursor { display: inline-block; width: 0.55em; height: 1em; vertical-align: text-bottom; background: var(--accent-light); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  @media (max-width: 600px) {
    .term-body { font-size: 0.78rem; padding: 1rem 1.1rem 1.15rem; }
    .row { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>