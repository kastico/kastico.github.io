---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fullUrl } from '../utils/media';

interface Props {
  folder: string;          // ex: "vira-lume/posters" (dentro de src/assets)
  columns?: number;        // colunas em desktop
  mobileColumns?: number;  // colunas em ecrãs <= 700px
  gap?: string;
  alt?: string;
  fillGaps?: boolean;      // true: se a última linha ficar incompleta, a 1.ª imagem ocupa mais colunas
}
const {
  folder,
  columns = 3,
  mobileColumns = 2,
  gap = '0.75rem',
  alt = '',
  fillGaps = true,
} = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>(
'/src/assets/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);
const prefix = `/src/assets/${folder.replace(/^\/|\/$/g, '')}/`;

const files = Object.entries(all)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }));

const items = await Promise.all(
  files.map(async ([, m]) => ({ img: m.default, full: await fullUrl(m.default) }))
);

// colunas extra que a 1.ª imagem precisa para a última linha ficar cheia
const firstSpan = (cols: number) => {
  if (!fillGaps || cols < 1) return 1;
  const rest = items.length % cols;
  return rest === 0 ? 1 : 1 + (cols - rest);
};

const style =
  `--cols:${columns};--cols-m:${mobileColumns};--gap:${gap};` +
  `--span:${firstSpan(columns)};--span-m:${firstSpan(mobileColumns)};`;
---

<div class="gallery" style={style}>
  {items.map(({ img, full }, n) => (
    <Image src={img} alt={`${alt} ${n + 1}`} width={700} loading="lazy" data-lightbox={`gallery-${folder}`} data-full={full} />
  ))}
</div>

<script>import '../scripts/lightbox';</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--gap);
    align-items: start;
    margin: 2rem 0;
  }
  .gallery > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 6px;
    cursor: zoom-in;
    transition: opacity 0.2s;
  }
  .gallery > :global(img):hover { opacity: 0.85; }
  .gallery > :global(img:first-child) { grid-column: span var(--span); }

  @media (max-width: 700px) {
    .gallery { grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
    .gallery > :global(img:first-child) { grid-column: span var(--span-m); }
  }
</style>
