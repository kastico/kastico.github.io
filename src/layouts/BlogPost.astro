---
import { Image } from 'astro:assets';
import PageLayout from './PageLayout.astro';
import Tag from '@components/tag.astro';
import TableOfContents from '@components/TableOfContents.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: any[];
  author?: string;
  readingTime?: number;
};
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  pinned = false,
  author = 'Kastico',
  headings = [],
  readingTime,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---

<PageLayout title={title} description={description}>
  <div class="read-progress" aria-hidden="true"><span id="readBar"></span></div>

  <div class:list={['post-head', { 'post-head--plain': !heroImage }]}>
    <div class="post-head-top">
      <a href="/blog" class="back-link">← Blog</a>
      {pinned && <span class="post-badge">Pinned</span>}
    </div>

    <h1 class="post-title">{title}</h1>
    {description && <p class="post-lede">{description}</p>}

    <div class="post-byline">
      <span>By <strong>{author}</strong></span>
      <span class="sep">·</span>
      <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      {readingTime && (
        <>
          <span class="sep">·</span>
          <span>{readingTime} min read</span>
        </>
      )}
      {updatedDate && (
        <>
          <span class="sep">·</span>
          <span>Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>
        </>
      )}
    </div>

    {tags.length > 0 && (
      <div class="post-tags post-tags--inline">
        {tags.map((t) => <Tag tag={t} size="sm" />)}
      </div>
    )}
  </div>

  {heroImage && (
    <Image src={heroImage} alt={title} class="post-cover" width={1600} height={640} />
  )}

  <div class="post-layout">
    <div class="prose" id="postProse">
      <slot />
    </div>

    <aside class="post-side">
      {tags.length > 0 && (
        <div class="post-side-tags">
          <span class="sidebar-label">Tags</span>
          <div class="tag-cloud">
            {tags.map((t) => <Tag tag={t} size="sm" />)}
          </div>
        </div>
      )}
      <div class="post-toc">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <script>
    const bar = document.getElementById('readBar');
    const prose = document.getElementById('postProse');
    if (bar && prose) {
      const update = () => {
        const rect = prose.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const done = Math.min(Math.max(-rect.top + window.innerHeight * 0.2, 0), total);
        bar.style.transform = `scaleX(${total > 0 ? done / total : 0})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</PageLayout>
