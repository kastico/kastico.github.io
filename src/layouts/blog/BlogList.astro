---
/**
 * BLOG LAYOUT 1 — LIST (default)
 * Left sidebar with tag filters + scrollable post list.
 */
import PageLayout from '../PageLayout.astro';
import Tag from '@components/tag.astro';
import { Image } from 'astro:assets';

interface Props { posts: any[]; title?: string; description?: string; }
const { posts, title = 'Blog', description = 'All posts' } = Astro.props;
const getSlug = (p) => p.id.replace(/\.(md|mdx)$/, '');
const sorted = [...posts].sort((a, b) => b.data.pubDate - a.data.pubDate);

const tagCounts: Record<string, number> = {};
sorted.forEach(p => (p.data.tags || []).forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1; }));
const allTags = Object.entries(tagCounts).sort(([,a],[,b]) => b - a).map(([t, c]) => ({ tag: t, count: c }));

// Show 12 tags inline, rest behind toggle
const visibleTags = allTags.slice(0, 12);
const hiddenTags = allTags.slice(12);
---

<PageLayout title={title} description={description}>
  <div class="blog-head">
    <h1 class="page-title">{title}</h1>
    <p class="page-desc">{description}</p>
  </div>

  <div class="blog-layout">
    <!-- Left sidebar: filters -->
    <aside class="blog-sidebar" id="blogSidebar">
      <span class="blog-sidebar-label">Filter by tag</span>

      <ul class="filter-list" id="filterList">
        <li class="filter-list-item">
          <button class="filter-list-btn active" data-tag="all">
            <span>All posts</span>
            <span class="filter-count">{sorted.length}</span>
          </button>
        </li>
        {visibleTags.map(({ tag, count }) => (
          <li class="filter-list-item">
            <button class="filter-list-btn" data-tag={tag}>
              <span>{tag}</span>
              <span class="filter-count">{count}</span>
            </button>
          </li>
        ))}
      </ul>

      {hiddenTags.length > 0 && (
        <div class="filter-overflow" id="filterOverflow">
          <ul class="filter-list">
            {hiddenTags.map(({ tag, count }) => (
              <li class="filter-list-item">
                <button class="filter-list-btn" data-tag={tag}>
                  <span>{tag}</span>
                  <span class="filter-count">{count}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
        <button class="filter-overflow-toggle" id="filterToggle">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="8" cy="4" r="1.5" fill="currentColor" stroke="none"/>
            <circle cx="8" cy="8" r="1.5" fill="currentColor" stroke="none"/>
            <circle cx="8" cy="12" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
          +{hiddenTags.length} more
        </button>
      )}
    </aside>

    <!-- Main content -->
    <div class="blog-content">
      <ul class="post-list" id="postList">
        {sorted.map(post => (
          <li data-tags={(post.data.tags || []).join(',')}>
            <a href={`/blog/${getSlug(post)}/`} class="post-row">
              {post.data.heroImage
                ? <Image src={post.data.heroImage} alt={post.data.title} class="post-row-img" width={400} height={300} />
                : <div class="post-row-placeholder"></div>
              }
              <div class="post-row-body">
                <p class="post-row-date">
                  {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
                </p>
                <p class="post-row-title">
                  {post.data.pinned && <span class="pinned-dot"></span>}
                  {post.data.title}
                </p>
                {post.data.description && <p class="post-row-desc">{post.data.description}</p>}
                {post.data.tags?.length > 0 && (
                  <div class="post-row-tags">
                    {post.data.tags.map(t => <Tag tag={t} size="sm" />)}
                  </div>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <script>
    // Filter
    const sidebar = document.getElementById('blogSidebar');
    const list = document.getElementById('postList');
    if (sidebar && list) {
      sidebar.addEventListener('click', e => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-list-btn');
        if (!btn) return;
        sidebar.querySelectorAll('.filter-list-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const tag = btn.dataset.tag!;
        list.querySelectorAll<HTMLLIElement>('li[data-tags]').forEach(li => {
          const tags = li.dataset.tags!.split(',').filter(Boolean);
          li.style.display = (tag === 'all' || tags.includes(tag)) ? '' : 'none';
        });
      });
    }

    // Overflow toggle
    const toggle = document.getElementById('filterToggle');
    const overflow = document.getElementById('filterOverflow');
    if (toggle && overflow) {
      overflow.style.display = 'none';
      toggle.addEventListener('click', () => {
        const open = overflow.style.display !== 'none';
        overflow.style.display = open ? 'none' : 'block';
        toggle.textContent = open ? `+${overflow.querySelectorAll('.filter-list-btn').length} more` : 'Show less';
      });
    }
  </script>
</PageLayout>
