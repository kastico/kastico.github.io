---
import Tag from '@components/tag.astro';
import { Image } from 'astro:assets';
import { getPostSlug } from '../../utils/slug';

interface Props { posts: any[]; }
const { posts } = Astro.props;
const getSlug = (p) => getPostSlug(p.id);
const sorted = [...posts].sort((a, b) => b.data.pubDate - a.data.pubDate);
---

<div class="blog-view" data-view="list">
  <ul class="post-list">
    {sorted.map(post => (
      <li data-tags={(post.data.tags || []).join(',')}>
        <a href={`/blog/${getSlug(post)}/`} class="post-row">
          {post.data.heroImage
            ? <Image src={post.data.heroImage} alt={post.data.title} class="post-row-img" width={400} height={300} />
            : <div class="post-row-placeholder"></div>
          }
          <div class="post-row-body">
            <p class="post-row-date">
              {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
            </p>
            <p class="post-row-title">
              {post.data.pinned && <span class="pinned-dot"></span>}
              {post.data.title}
            </p>
            {post.data.description && <p class="post-row-desc">{post.data.description}</p>}
            {post.data.tags?.length > 0 && (
              <div class="post-row-tags">
                {post.data.tags.map(t => <Tag tag={t} size="sm" />)}
              </div>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>
