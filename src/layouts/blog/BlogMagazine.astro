---
import Tag from '@components/tag.astro';
import { Image } from 'astro:assets';
import { getPostSlug } from '../../utils/slug';

interface Props { posts: any[]; }
const { posts } = Astro.props;
const getSlug = (p) => getPostSlug(p.id);
const sorted = [...posts].sort((a, b) => b.data.pubDate - a.data.pubDate);
const pinned = sorted.find(p => p.data.pinned);
const featured = pinned || sorted[0];
const rest = sorted.filter(p => p !== featured);
---

<div class="blog-view" data-view="magazine">
  {featured && (
    <div class="magazine-split">
      <a href={`/blog/${getSlug(featured)}/`} class="mag-featured" data-tags={(featured.data.tags || []).join(',')}>
        {featured.data.heroImage
          ? <Image src={featured.data.heroImage} alt={featured.data.title} class="mag-feat-img" width={800} height={400} />
          : <div class="mag-feat-placeholder"></div>
        }
        <span class="mag-feat-eyebrow">{pinned ? 'Pinned' : 'Latest'}</span>
        <h2 class="mag-feat-title">{featured.data.title}</h2>
        {featured.data.description && <p class="mag-feat-desc">{featured.data.description}</p>}
        <div class="mag-feat-meta">
          <span>{featured.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
          {(featured.data.tags || []).slice(0, 2).map(t => <Tag tag={t} size="sm" />)}
        </div>
      </a>
      <div class="mag-side">
        <span class="mag-side-label">Recent</span>
        {rest.slice(0, 6).map(post => (
          <a href={`/blog/${getSlug(post)}/`} class="mag-side-item" data-tags={(post.data.tags || []).join(',')}>
            {post.data.heroImage
              ? <Image src={post.data.heroImage} alt={post.data.title} class="mag-side-thumb" width={144} height={108} />
              : <div class="mag-side-placeholder"></div>
            }
            <div>
              <p class="mag-side-title">{post.data.title}</p>
              <p class="mag-side-date">{post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="blog-grid" style="--cols:3">
    {rest.slice(6).map(post => (
      <a href={`/blog/${getSlug(post)}/`} class="blog-grid-card" data-tags={(post.data.tags || []).join(',')}>
        {post.data.heroImage
          ? <Image src={post.data.heroImage} alt={post.data.title} class="blog-card-img" width={400} height={267} />
          : <div class="blog-card-placeholder"></div>
        }
        <div class="blog-card-body">
          <h2 class="blog-card-title">{post.data.title}</h2>
          <div class="blog-card-footer">
            <div class="tag-cloud">
              {(post.data.tags || []).slice(0, 2).map(t => <Tag tag={t} size="sm" />)}
            </div>
            <span class="blog-card-date">{post.data.pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
