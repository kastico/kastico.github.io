---
import Tag from '@components/tag.astro';
import { Image } from 'astro:assets';
import { getPostSlug } from '../../utils/slug';

interface Props { posts: any[]; columns?: 2 | 3; }
const { posts, columns = 3 } = Astro.props;
const getSlug = (p) => getPostSlug(p.id);
const sorted = [...posts].sort((a, b) => b.data.pubDate - a.data.pubDate);
---

<div class="blog-view" data-view="grid">
  <div class="blog-grid" style={`--cols: ${columns}`}>
    {sorted.map(post => (
      <a href={`/blog/${getSlug(post)}/`} class="blog-grid-card" data-tags={(post.data.tags || []).join(',')}>
        {post.data.heroImage
          ? <Image src={post.data.heroImage} alt={post.data.title} class="blog-card-img" width={600} height={400} />
          : <div class="blog-card-placeholder"></div>
        }
        <div class="blog-card-body">
          <h2 class="blog-card-title">{post.data.title}</h2>
          {post.data.description && <p class="blog-card-desc">{post.data.description}</p>}
          <div class="blog-card-footer">
            <div class="tag-cloud">
              {(post.data.tags || []).slice(0, 2).map(t => <Tag tag={t} size="sm" />)}
            </div>
            <span class="blog-card-date">
              {post.data.pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
