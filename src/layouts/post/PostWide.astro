---
import { Image } from 'astro:assets';
import PageLayout from '../PageLayout.astro';
import Tag from '@components/tag.astro';
import TableOfContents from '@components/TableOfContents.astro';

interface Props { title: string; description?: string; pubDate: Date; updatedDate?: Date; heroImage?: any; tags?: string[]; headings?: any[]; }
const { title, description, pubDate, updatedDate, heroImage, tags = [], headings = [] } = Astro.props;
---

<PageLayout title={title} description={description}>
  <div class="post-wide-head">
    <a href="/blog" class="back-link">← Blog</a>
    <h1 class="post-wide-title">{title}</h1>
    {description && <p class="post-wide-desc">{description}</p>}
  </div>

  {heroImage && <Image src={heroImage} alt={title} class="post-hero-img" width={1200} height={500} />}

  <div class="post-toc-wrap">
    <aside class="toc-sidebar">
      <TableOfContents headings={headings} />
    </aside>
    <div class="prose">
      <slot />
    </div>
    <aside class="toc-sidebar">
      <div class="sidebar-block">
        <span class="sidebar-label">Published</span>
        <ul class="meta-list">
          <li><span>Date</span><span class="meta-val">{pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}</span></li>
          {updatedDate && <li><span>Updated</span><span class="meta-val">{updatedDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' })}</span></li>}
        </ul>
      </div>
      {tags.length > 0 && (
        <div class="sidebar-block">
          <span class="sidebar-label">Tags</span>
          <div class="tag-cloud">{tags.map(t => <Tag tag={t} size="sm" />)}</div>
        </div>
      )}
    </aside>
  </div>
</PageLayout>
