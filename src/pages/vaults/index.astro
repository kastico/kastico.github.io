---
import PageLayout from '../../layouts/PageLayout.astro';
import Tag from '@components/tag.astro';
import { getCollection } from 'astro:content';

const allVaults = (await getCollection('vaults')).sort((a, b) => b.data.pubDate - a.data.pubDate);
const allProjects = await getCollection('projects');

const vaults = allVaults.map((vault, i) => {
  const slug = vault.id.replace(/\.(md|mdx)$/, '');
  const projects = allProjects.filter(p => p.data.vault === slug);
  return { vault, slug, projects, i };
});
---

<PageLayout title="Vaults" description="Collections of finished projects, organised by topic.">
  <div class="vaults-hero">
    <h1 class="page-title">Vaults</h1>
    <p class="page-desc">Collections of finished projects, experiments, and work — organised by topic.</p>
  </div>

  <div class="vaults-list">
    {vaults.map(({ vault, slug, projects, i }) => (
      <a href={`/vaults/${slug}/`} class="vault-row">
        <span class="vault-row-num">0{i + 1}</span>
        <div class="vault-row-inner">
          <div class="vault-row-content">
            <h2 class="vault-row-title">{vault.data.title}</h2>
            <p class="vault-row-desc">{vault.data.description}</p>
            <div class="vault-row-tags">
              {vault.data.tags.slice(0, 5).map(t => <Tag tag={t} size="sm" />)}
            </div>
          </div>
          <div class="vault-row-meta">
            <div class="vault-row-stats">
              <div class="vault-stat">
                <span class="vault-stat-val">{projects.length}</span>
                <span class="vault-stat-label">Projects</span>
              </div>
              <div class="vault-stat">
                <span class="vault-stat-val">{vault.data.tags.length}</span>
                <span class="vault-stat-label">Topics</span>
              </div>
            </div>
            <span class="vault-arrow">→</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</PageLayout>
