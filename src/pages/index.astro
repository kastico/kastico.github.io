---
import PageLayout from '../layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import Tag from '@components/tag.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION } from '../consts';

const allPosts = await getCollection('blog');
const sorted = [...allPosts].sort((a, b) => b.data.pubDate - a.data.pubDate);
const pinnedPost = allPosts.find(p => p.data.pinned);

const tagCounts: Record<string, number> = {};
allPosts.forEach(p => (p.data.tags || []).forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1; }));
const popularTags = Object.entries(tagCounts).sort(([,a],[,b]) => b - a).map(([t]) => t);

const allVaults = await getCollection('vaults');
const allProjects = await getCollection('projects');

const getSlug = (p) => p.id.replace(/\.(md|mdx)$/, '');
const rest = sorted.filter(p => p !== pinnedPost).slice(0, 6);
---

<PageLayout description={SITE_DESCRIPTION}>
  <style>
    /* New logo is wide (865x370), the old one was square, so it gets its own sizing.
       If your global CSS still has a .hero-logo rule, delete it. */
    .hero-title-wrap .hero-logo {
      display: block;
      width: clamp(220px, 34vw, 440px);
      height: auto;
      flex-shrink: 0;
      align-self: center;
    }
    @media (max-width: 700px) {
      .hero-title-wrap .hero-logo { width: clamp(150px, 42vw, 240px); }
    }
  </style>

  <section class="hero">
    <span class="hero-label">Digital Shelter</span>
    <div class="hero-title-wrap">
      <h1 class="hero-title">The<br /><em>Bunker</em></h1>
      <img src="/bunker-logo.svg" alt="" width="865" height="370" class="hero-logo" aria-hidden="true" />
    </div>
    <p class="hero-desc">A place to store knowledge, projects, thoughts, and experiments. Code, design, music — collected with intent.</p>
    <div class="hero-nav">
      <a href="/vaults" class="btn-primary">Explore Vaults</a>
      <a href="/blog" class="btn-ghost">Read the Blog →</a>
    </div>
  </section>

  <!-- VAULT STRIP -->
  <section class="vault-strip">
    <div class="vault-strip-inner">
      <div class="vault-strip-label">
        <span>Vaults</span>
        <a href="/vaults" class="vault-strip-all">View all →</a>
      </div>
      <div class="vault-strip-list">
        {allVaults.map(vault => {
          const slug = vault.id.replace(/\.(md|mdx)$/, '');
          const count = allProjects.filter(p => p.data.vault === slug).length;
          return (
            <a href={`/vaults/${slug}/`} class="vault-strip-item">
              <span class="vault-strip-name">{vault.data.title}</span>
              <span class="vault-strip-count">{count}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- POSTS -->
  <div class="home-layout">
    <div>
      <div class="home-posts-grid">
        <!-- Pinned: spans full width, larger -->
        {pinnedPost && (
          <a href={`/blog/${getSlug(pinnedPost)}/`} class="home-grid-card home-grid-pinned">
            {pinnedPost.data.heroImage
              ? <Image src={pinnedPost.data.heroImage} alt={pinnedPost.data.title} class="home-grid-img" width={1200} height={600} />
              : <div class="home-grid-placeholder"></div>
            }
            <div class="home-grid-body">
              <div class="home-grid-pinned-badge">Pinned</div>
              <p class="home-grid-title">{pinnedPost.data.title}</p>
              {pinnedPost.data.description && <p class="home-grid-desc">{pinnedPost.data.description}</p>}
              <p class="home-grid-date">
                {pinnedPost.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </p>
            </div>
          </a>
        )}
        <!-- Rest: 3-column grid -->
        {rest.map(post => (
          <a href={`/blog/${getSlug(post)}/`} class="home-grid-card">
            {post.data.heroImage
              ? <Image src={post.data.heroImage} alt={post.data.title} class="home-grid-img" width={600} height={400} />
              : <div class="home-grid-placeholder"></div>
            }
            <div class="home-grid-body">
              <p class="home-grid-title">{post.data.title}</p>
              <p class="home-grid-date">
                {post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
              </p>
            </div>
          </a>
        ))}
      </div>
      <div class="home-all-link">
        <a href="/blog" class="btn-ghost">All posts →</a>
      </div>
    </div>

    <aside class="home-sidebar">
      <div class="home-sidebar-block">
        <span class="home-sidebar-label">About</span>
        <p class="home-about">
          <strong>Vaults</strong> — finished projects, organised by topic.<br /><br />
          <strong>Blog</strong> — open notebook. Thoughts, experiments, work in progress.
        </p>
      </div>
      {popularTags.length > 0 && (
        <div class="home-sidebar-block">
          <span class="home-sidebar-label">Topics</span>
          <div class="tag-cloud">
            {popularTags.slice(0, 12).map(t => (
              <Tag tag={t} href={`/tags/${t.toLowerCase()}/`} size="sm" />
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</PageLayout>