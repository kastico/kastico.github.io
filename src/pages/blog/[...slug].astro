---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostSlug } from '../../utils/slug';
import { getPublished } from '../../utils/published';

export async function getStaticPaths() {
  const posts = await getPublished('blog');
  return posts.map((post) => ({
    params: { slug: getPostSlug(post.id) },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BlogPost {...post.data} headings={headings} readingTime={readingTime}>
  <Content />
</BlogPost>
